{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // Existing .js/.jsx keep working unchecked; files are moved to .ts/.tsx as the plan rewrites them
    "allowJs": true,
    "checkJs": false,
    // Vite builds with esbuild; tsc only checks types
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vite-plugin-svgr/client"]
  },
  "include": ["src", "../shared"],
  // Unit tests run in Node (`npm test`) with node:test; the browser code must not see Node's types
  "exclude": ["src/**/*.test.ts"]
}
