# Copy to .env for local development. In production set these in the hosting dashboard.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
# Local: postgresql://fintrack:PASSWORD@localhost:5432/fintrack
# Neon: the connection string from the Neon console (it already ends with ?sslmode=require)
DATABASE_URL=
# The client's origin, without a trailing slash: the CORS origin and the start of the links in emails
CLIENT_URL=http://localhost:5173
# Local development only: emails are printed to the server console instead of being sent. Never set it
# on the host, or nobody receives the verification and password reset emails
MAIL_TO_CONSOLE=1
# Required unless MAIL_TO_CONSOLE=1. MAIL_FROM must be on the domain verified in Resend
# RESEND_API_KEY=
# MAIL_FROM=FinTrack <noreply@your-domain>
# Optional
# PORT=5050
